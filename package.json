{
  "name": "ink-timer",
  "version": "0.2.4",
  "description": "Timer, countdown, and stopwatch hooks and components for Ink",
  "license": "MIT",
  "repository": "github:costajohnt/ink-timer",
  "homepage": "https://github.com/costajohnt/ink-timer#readme",
  "bugs": "https://github.com/costajohnt/ink-timer/issues",
  "author": "John Costa",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ink",
    "cli",
    "timer",
    "countdown",
    "stopwatch",
    "terminal",
    "react",
    "tui"
  ],
  "devDependencies": {
    "@costajohnt/ink-config": "github:costajohnt/ink-config",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "xo": "^5.0.1"
  },
  "peerDependencies": {
    "ink": ">=6.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
